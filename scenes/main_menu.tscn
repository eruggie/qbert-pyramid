[node name="InstructionsDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
title = "Informazioni sul gioco"
initial_position = 2
size = Vector2i(720, 300)
min_size = Vector2i(600, 260)
unresizable = true
ok_button_text = "Chiudi"
dialog_text = "QBERT Rev. 1.1 · Aggiornamento del gioco\nAutore: Eugenio Ruggieri\nLicenza del gioco: GNU GPL v3.0 (GPL-3.0-only)\nTesto integrale: LICENSE nella cartella del gioco.\n\nCOME SI GIOCA\nColora 28 celle come il cubo obiettivo. Tre vite iniziali.\nEvita sfere rosse, serpente e ragnetti viola.\nRaccogli il sabotatore verde con piedi: 300 punti.\nLa sfera verde ferma i nemici e protegge i contatti per 5 s.\nLe cadute restano letali. Dischi: sinistra fila 4, destra fila 6.\nQ/Sinistra: alto-sinistra · E/Su: alto-destra\nZ/Giù: basso-sinistra · C/Destra: basso-destra · KP 7/9/1/3\nP: pausa/riprendi · Esc: menu · F11: schermo intero\nIn pausa: frecce/Tab e Invio per la GUI; nuova partita disponibile.\nExtra a 8.000 punti, poi ogni 14.000. Record e tasti persistenti.\nLaboratorio: R reset; selettore Regola mette in pausa e reimposta.\nSolo effetti di gioco. Volume, mute e tasti nelle Impostazioni.\n(c) Eugenio Ruggieri 2026 GNU GPL v3.0"
dialog_autowrap = true

[node name="StatusDialog" type="AcceptDialog" parent="."]
unique_name_in_owner = true
title = "Stato del progetto"
initial_position = 2
size = Vector2i(720, 300)
min_size = Vector2i(600, 260)
unresizable = true
ok_button_text = "Chiudi"
dialog_text = "Fase 3: avversari, dischi di salvataggio, Stasi protettiva e progressione continua.\n\nSono disponibili laboratorio e controlli lettere/frecce/tastierino.\nDopo il round 12 la partita continua dal livello 4.\n\nAudio, record e salvataggi sono della fase 4."
dialog_autowrap = true
