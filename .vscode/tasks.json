{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Verifica ambiente",
      "type": "process",
      "command": "bash",
      "args": ["tools/doctor.sh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test logica",
      "type": "process",
      "command": "bash",
      "args": ["tools/test.sh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Build Windows",
      "type": "process",
      "command": "bash",
      "args": ["tools/build_windows.sh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
